<?xml version="1.0" encoding="UTF-8"?>

<?import cr.ac.una.est.programacion03proyecto02.view.personalizacion.BotonTema?>

<?import cr.ac.una.est.programacion03proyecto02.view.iconos.Icono?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.seguridad.menuController"
            prefWidth="900.0" prefHeight="600.0" styleClass="page-container">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar">
            <Label text="Menú principal" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUsuario" styleClass="muted-text"/>
            <BotonTema fx:id="btnTema"/>
            <Button text="Cerrar sesión" onAction="#onCerrarSesion" styleClass="button-secondary"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="16.0">
            <Label text="Seleccione un módulo" styleClass="page-subtitle"/>
            <TilePane alignment="CENTER" hgap="16.0" vgap="16.0" prefColumns="2"
                      prefTileWidth="320.0" prefTileHeight="180.0">
                <Button fx:id="btnInventario" text="Inventario" onAction="#onInventario"
                        accessibleText="Abrir inventario" styleClass="module-card" contentDisplay="TOP" graphicTextGap="10.0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Icono tipo="INVENTARIO"/>
                            <Label text="Consulte existencias y registre movimientos." styleClass="module-description" wrapText="true" maxWidth="270.0"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="btnCatalogo" text="Catálogo de productos" onAction="#onCatalogo"
                        accessibleText="Abrir catálogo de productos" styleClass="module-card" contentDisplay="TOP" graphicTextGap="10.0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Icono tipo="CATALOGO"/>
                            <Label text="Administre productos, categorías y precios." styleClass="module-description" wrapText="true" maxWidth="270.0"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="btnReportes" text="Reportes" onAction="#onReportes"
                        accessibleText="Abrir reportes" styleClass="module-card" contentDisplay="TOP" graphicTextGap="10.0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Icono tipo="REPORTES"/>
                            <Label text="Revise ingresos, ventas e historial de pedidos." styleClass="module-description" wrapText="true" maxWidth="270.0"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="btnPedidos" text="Pedidos" onAction="#onPedidos"
                        accessibleText="Abrir pedidos activos" styleClass="module-card button-accent" contentDisplay="TOP" graphicTextGap="10.0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Icono tipo="PEDIDOS"/>
                            <Label text="Tome pedidos, gestione su preparación y cobre." styleClass="module-description" wrapText="true" maxWidth="270.0"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="btnUsuarios" text="Usuarios y roles" onAction="#onUsuarios" styleClass="module-card"
                        contentDisplay="TOP" graphicTextGap="10">
                    <graphic><Label text="Cree cuentas de administrador, inventario y cajero." styleClass="module-description" wrapText="true" maxWidth="270"/></graphic>
                </Button>
            </TilePane>
        </VBox>
    </center>
</BorderPane>
