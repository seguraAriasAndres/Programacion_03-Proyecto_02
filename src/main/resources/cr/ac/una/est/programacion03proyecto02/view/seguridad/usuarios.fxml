<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import cr.ac.una.est.programacion03proyecto02.view.personalizacion.BotonTema?>
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="cr.ac.una.est.programacion03proyecto02.controller.seguridad.UsuariosController"
 prefWidth="1100" prefHeight="720" styleClass="page-container">
 <top><VBox spacing="12">
  <HBox alignment="CENTER_LEFT" spacing="12">
   <Label text="Administración de usuarios" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/>
   <BotonTema fx:id="btnTema"/><Button text="Volver al menú" onAction="#onVolver"/>
  </HBox>
  <VBox spacing="10" styleClass="card">
   <Label text="Crear una cuenta" styleClass="section-title"/>
   <GridPane hgap="10" vgap="10">
    <Label text="Usuario"/><TextField fx:id="txtUsuario" promptText="Nombre de acceso" GridPane.columnIndex="1"/>
    <Label text="Rol" GridPane.columnIndex="2"/><ComboBox fx:id="cmbRol" GridPane.columnIndex="3"/>
    <Label text="Clave" GridPane.rowIndex="1"/><PasswordField fx:id="txtClave" promptText="De 8 a 128 caracteres" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Confirmar clave" GridPane.rowIndex="1" GridPane.columnIndex="2"/><PasswordField fx:id="txtConfirmacion" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
   </GridPane>
   <HBox spacing="10" alignment="CENTER_LEFT"><CheckBox fx:id="chkActivo" text="Activa" selected="true"/>
    <Button fx:id="btnCrearUsuario" text="Crear usuario" onAction="#onCrear" styleClass="button-primary"/>
    <Button fx:id="btnActualizar" text="Actualizar lista" onAction="#onActualizar"/>
   </HBox>
  </VBox>
 </VBox></top>
 <center><TableView fx:id="tblUsuarios"><BorderPane.margin><Insets top="12" bottom="12"/></BorderPane.margin>
  <columns><TableColumn fx:id="colId" text="ID" prefWidth="100"/><TableColumn fx:id="colNombre" text="Usuario" prefWidth="350"/>
   <TableColumn fx:id="colRol" text="Rol" prefWidth="220"/><TableColumn fx:id="colActivo" text="Activa" prefWidth="100"/></columns>
  <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
 </TableView></center>
 <bottom><Label fx:id="lblMensaje" wrapText="true" styleClass="status-message"/></bottom>
</BorderPane>
