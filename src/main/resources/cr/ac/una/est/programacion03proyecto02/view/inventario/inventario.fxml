<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.inventario.inventarioController"
            prefWidth="1150.0" prefHeight="720.0" styleClass="page-container">
    <top>
        <VBox spacing="12.0">
            <Label text="Inventario" styleClass="page-title"/>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="toolbar">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar"/>
                <Button text="Volver al menú" onAction="#onVolver" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Registrar movimiento:" styleClass="section-title"/>
                <ComboBox fx:id="cmbIngrediente" promptText="Ingrediente" prefWidth="230.0"/>
                <TextField fx:id="txtCantidad" promptText="Cantidad" prefWidth="110.0"/>
                <TextField fx:id="txtMotivo" promptText="Motivo" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnReabastecer" text="Reabastecer" onAction="#onReabastecer" styleClass="button-accent"/>
                <Button fx:id="btnMerma" text="Registrar merma" onAction="#onRegistrarMerma" styleClass="button-danger"/>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Alta / edición:" styleClass="section-title"/>
                <TextField fx:id="txtNombreIngrediente" promptText="Nombre" prefWidth="200.0"/>
                <ComboBox fx:id="cmbUnidad" promptText="Unidad" prefWidth="130.0"/>
                <TextField fx:id="txtStockMinimo" promptText="Stock mínimo" prefWidth="110.0"/>
                <CheckBox fx:id="chkActivo" text="Activo" selected="true"/>
                <Button fx:id="btnNueva" text="Nueva" onAction="#onNueva"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar" styleClass="button-primary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.42">
            <BorderPane.margin><Insets top="12.0" bottom="12.0"/></BorderPane.margin>
            <items>
                <VBox spacing="6.0">
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label text="Ingredientes" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnBajoMinimo" text="Ver bajo mínimo" onAction="#onBajoMinimo" styleClass="button-danger"/>
                    </HBox>
                    <TableView fx:id="tblIngredientes" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIngredienteId" text="ID" prefWidth="80.0"/>
                            <TableColumn fx:id="colIngredienteNombre" text="Ingrediente" prefWidth="280.0"/>
                            <TableColumn fx:id="colIngredienteDisponible" text="Disponible" prefWidth="140.0"/>
                            <TableColumn fx:id="colIngredienteMinimo" text="Stock mínimo" prefWidth="140.0"/>
                            <TableColumn fx:id="colIngredienteActiva" text="Activo" prefWidth="110.0"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
                <VBox spacing="6.0">
                    <Label text="Movimientos del período" styleClass="section-title"/>
                    <TableView fx:id="tblMovimientos" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="150.0"/>
                            <TableColumn fx:id="colMovIngrediente" text="Ingrediente" prefWidth="200.0"/>
                            <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="150.0"/>
                            <TableColumn fx:id="colMovCantidad" text="Cantidad" prefWidth="100.0"/>
                            <TableColumn fx:id="colMovUsuario" text="Usuario" prefWidth="140.0"/>
                            <TableColumn fx:id="colMovMotivo" text="Motivo" prefWidth="260.0"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </center>

    <bottom>
        <Label fx:id="lblMensaje" styleClass="status-message" wrapText="true"/>
    </bottom>
</BorderPane>
