<?xml version="1.0" encoding="UTF-8"?>

<?import cr.ac.una.est.programacion03proyecto02.view.iconos.Icono?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="raiz" prefHeight="680.0" prefWidth="950.0"
            styleClass="page-container" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.pedidos.CobroController">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets bottom="16.0" left="20.0" right="20.0" top="20.0"/></padding>

            <Label text="Cobrar pedido" styleClass="page-title"/>

            <HBox spacing="28.0" styleClass="card">
                <VBox spacing="4.0">
                    <Label text="Pedido" styleClass="muted-text"/>
                    <Label fx:id="lblPedido" text="-" styleClass="section-title"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Cliente" styleClass="muted-text"/>
                    <Label fx:id="lblCliente" text="-" wrapText="true"/>
                </VBox>
            </HBox>

            <TableView fx:id="tblLineas" editable="false" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProducto" prefWidth="220.0" text="Producto"/>
                    <TableColumn fx:id="colOpciones" prefWidth="260.0" text="Opciones / extras"/>
                    <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad"/>
                    <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio unitario"/>
                    <TableColumn fx:id="colSubtotal" prefWidth="150.0" text="Subtotal"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="card">
                <Label text="Total del pedido" styleClass="section-title"/>
                <Label fx:id="lblTotal" text="-" styleClass="page-title"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar">
                <Label text="Método de pago:" styleClass="section-title"/>
                <ChoiceBox fx:id="chMetodoPago" prefWidth="220.0"/>
            </HBox>

            <Label fx:id="lblMensaje" maxWidth="Infinity"
                   text="Seleccione un método de pago para continuar."
                   wrapText="true" styleClass="status-message"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnActualizar" text="Actualizar pedido" onAction="#onActualizar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="Volver a pedidos" onAction="#onCerrar" graphicTextGap="8.0"><graphic><Icono tipo="VOLVER"/></graphic></Button>
                <Button fx:id="btnCobrar" text="Confirmar cobro" onAction="#onCobrar"
                        styleClass="button-primary" disable="true" graphicTextGap="8.0"><graphic><Icono tipo="COBRAR"/></graphic></Button>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
