<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="raiz" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.est.programacion03proyecto02.controller.pedidos.CobroController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="COBRAR PEDIDO" textAlignment="CENTER" textOverrun="CENTER_WORD_ELLIPSIS">
               <font>
                  <Font size="15.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin></Label>
            <GridPane hgap="12.0" vgap="8.0">
              <columnConstraints>
                <ColumnConstraints hgrow="NEVER" />
                <ColumnConstraints hgrow="NEVER" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints />
                <RowConstraints />
              </rowConstraints>
               <children>
                  <Label text="Pedido #" />
                  <Label fx:id="lblPedido" text="---" GridPane.columnIndex="1" />
                  <Label text="Cliente:" GridPane.rowIndex="1" />
                  <Label fx:id="lblCliente" text="---" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            <TableView fx:id="tblLineas" editable="false" prefHeight="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colProducto" prefWidth="180.0" text="Producto" />
                <TableColumn fx:id="colOpciones" prefWidth="200.0" text="Opciones / extras" />
                <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cantidad" />
                <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio unitario" />
                <TableColumn fx:id="colSubtotal" prefWidth="130.0" text="Subtotal" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <GridPane alignment="CENTER_RIGHT" hgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="NEVER" />
                <ColumnConstraints hgrow="NEVER" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints />
              </rowConstraints>
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total:" />
                  <Label fx:id="lblTotal" style="-fx-font-size: 18px;" text="---" GridPane.columnIndex="1" />
               </children>
            </GridPane>
            <GridPane alignment="CENTER_LEFT" hgap="10.0" nodeOrientation="LEFT_TO_RIGHT" prefHeight="30.0" prefWidth="320.0">
              <columnConstraints>
                <ColumnConstraints hgrow="NEVER" />
                <ColumnConstraints hgrow="NEVER" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Método de pago:" />
                  <ChoiceBox fx:id="chMetodoPago" prefWidth="180.0" GridPane.columnIndex="1" />
               </children>
            </GridPane>
            <Label fx:id="lblMensaje" maxWidth="Infinity" text="Seleccione un método de pago para continuar." wrapText="true" />
            <!-- Acciones conectadas al controlador de cobro. -->
            <GridPane alignment="CENTER_RIGHT" hgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="NEVER" />
                <ColumnConstraints hgrow="NEVER" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Button fx:id="btnActualizar" text="Actualizar pedido" onAction="#onActualizar" GridPane.columnIndex="2" />
                  <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onCerrar" text="Volver a pedidos" />
                  <Button fx:id="btnCobrar" disable="true" mnemonicParsing="false" onAction="#onCobrar" text="Confirmar cobro" GridPane.columnIndex="1" />
               </children>
            </GridPane>
         </children></VBox>
   </children>
</AnchorPane>
