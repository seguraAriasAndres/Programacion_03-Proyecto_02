<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.catalogo.CategoriasController"
            prefWidth="760.0"
            prefHeight="480.0">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>

            <Label text="Administración de categorías"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <HBox spacing="10.0">
                <TextField fx:id="txtNombre"
                           promptText="Nombre de la categoría"
                           HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkActiva"
                          text="Activa"
                          selected="true"/>
            </HBox>

            <HBox spacing="10.0">
                <Button fx:id="btnActualizar"
                        text="Actualizar"
                        onAction="#onActualizar"/>
                <Button fx:id="btnNueva"
                        text="Nueva"
                        onAction="#onNueva"/>
                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblCategorias">
            <columns>
                <TableColumn fx:id="colCategoriaId"
                             text="ID"
                             prefWidth="100.0"/>
                <TableColumn fx:id="colCategoriaNombre"
                             text="Nombre"
                             prefWidth="400.0"/>
                <TableColumn fx:id="colCategoriaActiva"
                             text="Activa"
                             prefWidth="160.0"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="No hay categorías para mostrar."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="lblMensaje">
            <BorderPane.margin>
                <Insets top="10.0" right="20.0" bottom="15.0" left="20.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>