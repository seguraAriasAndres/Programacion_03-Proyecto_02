<?xml version="1.0" encoding="UTF-8"?>

<?import cr.ac.una.est.programacion03proyecto02.view.personalizacion.BotonTema?>

<?import cr.ac.una.est.programacion03proyecto02.view.iconos.Icono?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.catalogo.CategoriasController"
            prefWidth="760.0"
            prefHeight="560.0" styleClass="page-container">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="0.0" right="0.0" bottom="8.0" left="0.0"/>
            </padding>            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Administración de categorías" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <BotonTema fx:id="btnTema"/>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="toolbar">
                <TextField fx:id="txtNombre"
                           promptText="Nombre de la categoría"
                           HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkActiva"
                          text="Activa"
                          selected="true"/>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="toolbar">
                <Button fx:id="btnActualizar"
                        text="Actualizar"
                        onAction="#onActualizar"/>
                <Button fx:id="btnNueva"
                        text="Nueva"
                        onAction="#onNueva"
                        styleClass="button-accent" graphicTextGap="8.0"><graphic><Icono tipo="NUEVO"/></graphic></Button>
                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#onGuardar"
                        styleClass="button-primary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Volver al menú"
                        onAction="#onVolver"
                        styleClass="button-primary" graphicTextGap="8.0"><graphic><Icono tipo="VOLVER"/></graphic></Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblCategorias">
            <columns>
                <TableColumn fx:id="colCategoriaId"
                             text="ID"
                             prefWidth="100.0"/>
                <TableColumn fx:id="colCategoriaNombre"
                             text="Nombre"
                             prefWidth="400.0"/>
                <TableColumn fx:id="colCategoriaActiva"
                             text="Activa"
                             prefWidth="160.0"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="No hay categorías para mostrar."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="lblMensaje" styleClass="status-message">
            <BorderPane.margin>
                <Insets top="10.0" right="20.0" bottom="15.0" left="20.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
