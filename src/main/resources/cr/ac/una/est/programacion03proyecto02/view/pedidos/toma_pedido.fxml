<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.pedidos.TomaPedidosController"
            prefWidth="1150" prefHeight="800">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <top>
        <VBox spacing="12">
            <Label text="Toma de pedido" styleClass="page-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
                <Label text="Pedido:"/><Label fx:id="lblPedido" text="Nuevo"/>
                <Label text="Cliente:"/>
                <TextField fx:id="txtCliente" promptText="Nombre del cliente" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCrear" text="Crear borrador" onAction="#onCrear"/>
                <Button fx:id="btnActualizar" text="Actualizar pedido" onAction="#onActualizar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.53">
            <BorderPane.margin><Insets top="16" bottom="16"/></BorderPane.margin>
            <items>
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
                        <Label text="Categoría:"/>
                        <ComboBox fx:id="cmbCategoria" promptText="Todas las categorías" prefWidth="250"/>
                        <Button fx:id="btnActualizarCatalogo" text="Actualizar catálogo" onAction="#onActualizarCatalogo"/>
                    </HBox>
                    <SplitPane dividerPositions="0.62" VBox.vgrow="ALWAYS">
                        <items>
                            <TableView fx:id="tblProductos" editable="false">
                                <columns>
                                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="290"/>
                                    <TableColumn fx:id="colPrecioProducto" text="Precio base" prefWidth="130"/>
                                    <TableColumn fx:id="colDisponible" text="Disponibilidad" prefWidth="130"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                            <VBox spacing="6">
                                <Label text="Opciones y extras (Ctrl para elegir varios)" wrapText="true"/>
                                <ListView fx:id="lstOpciones" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </items>
                    </SplitPane>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Cantidad:"/>
                        <TextField fx:id="txtCantidad" text="1" prefWidth="80"/>
                        <Button fx:id="btnAgregar" text="Agregar al pedido" onAction="#onAgregarLinea"/>
                    </HBox>
                </VBox>
                <VBox spacing="10">
                    <Label text="Productos del pedido" styleClass="section-title"/>
                    <TableView fx:id="tblLineas" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colLineaProducto" text="Producto" prefWidth="300"/>
                            <TableColumn fx:id="colExtras" text="Opciones / extras" prefWidth="300"/>
                            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
                            <TableColumn fx:id="colPrecio" text="Precio unitario" prefWidth="150"/>
                            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="btnQuitar" text="Quitar línea seleccionada" onAction="#onQuitarLinea"/>
                        <Label text="Total:" styleClass="section-title"/>
                        <Label fx:id="lblTotal" text="0.00" styleClass="section-title"/>
                    </HBox>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <VBox spacing="12">
            <Label fx:id="lblEstado" wrapText="true" styleClass="status-message"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnVolver" text="Volver a pedidos" onAction="#onVolver"/>
                <Button fx:id="btnConfirmar" text="Confirmar pedido" onAction="#onConfirmar" styleClass="button-primary"/>
                <Button fx:id="btnCobrar" text="Ir a cobro" onAction="#onCobrar" styleClass="button-accent"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
