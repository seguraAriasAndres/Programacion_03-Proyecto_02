<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import cr.ac.una.est.programacion03proyecto02.view.personalizacion.BotonTema?>
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="cr.ac.una.est.programacion03proyecto02.controller.catalogo.ProductoEditorController"
 prefWidth="1100" prefHeight="800" styleClass="page-container">
 <top><VBox spacing="12">
  <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Editor de producto" styleClass="page-title"/>
   <Region HBox.hgrow="ALWAYS"/><BotonTema fx:id="btnTema"/>
  </HBox>
  <GridPane hgap="12" vgap="10" styleClass="card">
   <Label text="Nombre"/><TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1"/>
   <Label text="Precio base" GridPane.columnIndex="2"/><TextField fx:id="txtPrecioBase" promptText="0.00" GridPane.columnIndex="3"/>
   <Label text="Categoría" GridPane.rowIndex="1"/><ComboBox fx:id="cmbCategoria" promptText="Seleccione categoría" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
   <CheckBox fx:id="chkActivo" text="Activo" selected="true" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
  </GridPane>
 </VBox></top>
 <center><TabPane fx:id="tabEditor" tabClosingPolicy="UNAVAILABLE">
  <tabs>
   <Tab text="Receta del producto"><content><VBox spacing="12" styleClass="card">
    <Label text="Ingredientes de la receta base" styleClass="section-title"/>
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
     <ComboBox fx:id="cmbIngrediente" promptText="Ingrediente" prefWidth="240"/>
     <TextField fx:id="txtCantidadReceta" promptText="Cantidad en la unidad del ingrediente"/>
     <Button fx:id="btnAgregarBase" text="Agregar ingrediente" onAction="#onAgregarIngredienteBase" styleClass="button-accent"/>
     <Button fx:id="btnQuitarBase" text="Quitar ingrediente" onAction="#onQuitarIngredienteBase"/>
    </FlowPane>
    <TableView fx:id="tblRecetaBase" VBox.vgrow="ALWAYS">
     <columns><TableColumn fx:id="colBaseIngrediente" text="Ingrediente" prefWidth="450"/><TableColumn fx:id="colBaseCantidad" text="Cantidad por producto" prefWidth="200"/></columns>
     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
   </VBox></content></Tab>
   <Tab text="Extras y acompañamientos"><content><ScrollPane fitToWidth="true"><content><VBox spacing="10" styleClass="card">
    <Label text="Crear un extra con ingredientes o con un producto existente" styleClass="section-title" wrapText="true"/>
    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Origen"/><ComboBox fx:id="cmbOrigenOpcion" prefWidth="230"/></HBox>
    <HBox fx:id="filaProductoOpcion" spacing="10" alignment="CENTER_LEFT">
     <Label text="Producto de origen"/><ComboBox fx:id="cmbProductoOpcion" promptText="Producto con receta" prefWidth="300"/>
     <Label text="Se usará siempre su receta vigente." wrapText="true" styleClass="muted-text"/>
    </HBox>
    <HBox fx:id="filaIngredienteOpcion" spacing="10" alignment="CENTER_LEFT">
     <ComboBox fx:id="cmbIngredienteOpcion" promptText="Ingrediente del extra" prefWidth="270"/>
     <TextField fx:id="txtCantidadOpcion" text="1" promptText="Cantidad del ingrediente por extra"/>
    </HBox>
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
     <TextField fx:id="txtNombreOpcion" promptText="Nombre del extra"/>
     <ComboBox fx:id="cmbTipoOpcion" promptText="Tipo"/>
     <TextField fx:id="txtPrecioOpcion" promptText="Precio adicional"/>
     <CheckBox fx:id="chkOpcionActiva" text="Activa" selected="true"/>
     <Button fx:id="btnAgregarOpcion" text="Crear extra" onAction="#onAgregarOpcion" styleClass="button-accent"/>
     <Button fx:id="btnQuitarOpcion" text="Eliminar extra" onAction="#onQuitarOpcion" styleClass="button-danger"/>
    </FlowPane>
    <TableView fx:id="tblOpciones" prefHeight="140" minHeight="100">
     <columns><TableColumn fx:id="colOpcionNombre" text="Extra" prefWidth="300"/><TableColumn fx:id="colOpcionTipo" text="Tipo" prefWidth="180"/>
      <TableColumn fx:id="colOpcionPrecio" text="Precio adicional" prefWidth="180"/><TableColumn fx:id="colOpcionActiva" text="Activa" prefWidth="100"/></columns>
     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
    <Label fx:id="lblOrigenOpcion" text="Seleccione una opción para consultar sus ingredientes." wrapText="true" styleClass="muted-text"/>
    <CheckBox fx:id="chkEstadoOpcion" text="Extra seleccionado activo" onAction="#onCambiarEstadoOpcion"/>
    <FlowPane hgap="8" vgap="8">
     <Button fx:id="btnAgregarRecetaOpcion" text="Añadir el ingrediente al extra seleccionado" onAction="#onAgregarIngredienteOpcion"/>
     <Button fx:id="btnQuitarRecetaOpcion" text="Quitar ingrediente del extra" onAction="#onQuitarIngredienteOpcion"/>
    </FlowPane>
    <TableView fx:id="tblRecetaOpcion" prefHeight="140" minHeight="100">
     <columns><TableColumn fx:id="colOpcionIngrediente" text="Ingrediente descontado" prefWidth="450"/><TableColumn fx:id="colOpcionCantidad" text="Cantidad por extra" prefWidth="200"/></columns>
     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
   </VBox></content></ScrollPane></content></Tab>
  </tabs>
 </TabPane></center>
 <bottom><VBox spacing="8">
  <Label fx:id="lblMensaje" wrapText="true" styleClass="status-message"/>
  <HBox spacing="10"><Button fx:id="btnGuardar" text="Guardar producto y extras" onAction="#onGuardar" styleClass="button-primary"/>
   <Button text="Volver" onAction="#onVolver"/>
  </HBox>
 </VBox></bottom>
</BorderPane>
