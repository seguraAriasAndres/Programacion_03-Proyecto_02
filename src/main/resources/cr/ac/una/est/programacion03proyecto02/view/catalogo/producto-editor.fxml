<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.catalogo.ProductoEditorController"
            prefWidth="1000.0"
            prefHeight="720.0">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="18.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>

            <Label text="Editor de producto" styleClass="page-title"/>

            <GridPane hgap="10.0" vgap="10.0" styleClass="toolbar">
                <Label text="Nombre:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Precio base:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtPrecioBase"
                           promptText="0.00"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                <Label text="Categoría:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="cmbCategoria"
                          promptText="Seleccione categoría"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <CheckBox fx:id="chkActivo"
                          text="Activo"
                          selected="true"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER">
            <content>
                <VBox spacing="14.0">
                    <padding>
                        <Insets top="8.0" right="20.0" bottom="12.0" left="20.0"/>
                    </padding>

                    <Label text="Opciones del producto" styleClass="section-title"/>

                    <HBox spacing="8.0" styleClass="toolbar">
                        <TextField fx:id="txtNombreOpcion"
                                   promptText="Nombre de la opción"/>
                        <ComboBox fx:id="cmbTipoOpcion"
                                  promptText="Tipo"/>
                        <TextField fx:id="txtPrecioOpcion"
                                   promptText="Precio adicional"/>
                        <CheckBox fx:id="chkOpcionActiva"
                                  text="Activa"
                                  selected="true"/>
                        <Button fx:id="btnAgregarOpcion"
                                text="Agregar opción"
                                onAction="#onAgregarOpcion"/>
                        <Button fx:id="btnQuitarOpcion"
                                text="Quitar opción"
                                onAction="#onQuitarOpcion"/>
                    </HBox>

                    <TableView fx:id="tblOpciones" prefHeight="140.0">
                        <columns>
                            <TableColumn fx:id="colOpcionNombre"
                                         text="Nombre"
                                         prefWidth="250.0"/>
                            <TableColumn fx:id="colOpcionTipo"
                                         text="Tipo"
                                         prefWidth="180.0"/>
                            <TableColumn fx:id="colOpcionPrecio"
                                         text="Precio adicional"
                                         prefWidth="180.0"/>
                            <TableColumn fx:id="colOpcionActiva"
                                         text="Activa"
                                         prefWidth="120.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Label text="Receta base" styleClass="section-title"/>

                    <HBox spacing="8.0" styleClass="toolbar">
                        <ComboBox fx:id="cmbIngrediente"
                                  promptText="Ingrediente"/>
                        <TextField fx:id="txtCantidadReceta"
                                   promptText="Cantidad requerida"/>
                        <Button fx:id="btnAgregarBase"
                                text="Agregar a receta base"
                                onAction="#onAgregarIngredienteBase"/>
                        <Button fx:id="btnQuitarBase"
                                text="Quitar de receta base"
                                onAction="#onQuitarIngredienteBase"/>
                    </HBox>

                    <TableView fx:id="tblRecetaBase" prefHeight="120.0">
                        <columns>
                            <TableColumn fx:id="colBaseIngrediente"
                                         text="Ingrediente"
                                         prefWidth="300.0"/>
                            <TableColumn fx:id="colBaseCantidad"
                                         text="Cantidad requerida"
                                         prefWidth="220.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Label text="Receta de la opción seleccionada" styleClass="section-title"/>

                    <HBox spacing="8.0">
                        <Button fx:id="btnAgregarRecetaOpcion"
                                text="Agregar ingrediente a opción"
                                onAction="#onAgregarIngredienteOpcion"/>
                        <Button fx:id="btnQuitarRecetaOpcion"
                                text="Quitar ingrediente de opción"
                                onAction="#onQuitarIngredienteOpcion"/>
                    </HBox>

                    <TableView fx:id="tblRecetaOpcion" prefHeight="120.0">
                        <columns>
                            <TableColumn fx:id="colOpcionIngrediente"
                                         text="Ingrediente"
                                         prefWidth="300.0"/>
                            <TableColumn fx:id="colOpcionCantidad"
                                         text="Cantidad requerida"
                                         prefWidth="220.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="8.0">
            <padding>
                <Insets top="8.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <Label fx:id="lblMensaje" styleClass="status-message" wrapText="true"/>

            <HBox spacing="10.0">
                <Button fx:id="btnGuardar"
                        text="Guardar producto"
                        onAction="#onGuardar"
                        styleClass="button-primary"/>
                <Button fx:id="btnVolver"
                        text="Volver"
                        onAction="#onVolver"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>