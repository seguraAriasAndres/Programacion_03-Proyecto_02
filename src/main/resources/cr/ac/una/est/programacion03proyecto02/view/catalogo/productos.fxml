<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cr.ac.una.est.programacion03proyecto02.controller.catalogo.ProductosController"
            prefWidth="900.0"
            prefHeight="560.0">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>

            <Label text="Productos" styleClass="page-title"/>

            <HBox spacing="10.0" styleClass="toolbar">
                <Label text="Categoría:"/>

                <ComboBox fx:id="cmbCategoria"
                          promptText="Todas las categorías"
                          prefWidth="260.0"/>

                <Button fx:id="btnActualizar"
                        text="Actualizar"
                        onAction="#onActualizar"/>

                <Button fx:id="btnNuevo"
                        text="Nuevo"
                        onAction="#onNuevo"
                        styleClass="button-accent"/>

                <Button fx:id="btnEditar"
                        text="Editar"
                        onAction="#onEditar"/>

                <Button fx:id="btnDesactivar"
                        text="Desactivar"
                        onAction="#onDesactivar"
                        styleClass="button-danger"/>

                <Button text="Categorías"
                        onAction="#onCategorias"
                        HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblProductos">
            <columns>
                <TableColumn fx:id="colProductoId"
                             text="ID"
                             prefWidth="80.0"/>

                <TableColumn fx:id="colProductoNombre"
                             text="Nombre"
                             prefWidth="250.0"/>

                <TableColumn fx:id="colProductoCategoria"
                             text="Categoría"
                             prefWidth="190.0"/>

                <TableColumn fx:id="colProductoPrecio"
                             text="Precio base"
                             prefWidth="130.0"/>

                <TableColumn fx:id="colProductoDisponible"
                             text="Disponible"
                             prefWidth="130.0"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="No hay productos para mostrar."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="lblMensaje" styleClass="status-message">
            <BorderPane.margin>
                <Insets top="10.0" right="20.0" bottom="15.0" left="20.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>